<Window x:Class="CyberTrap.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CYBER TRAP // Night City crossover" Width="1120" Height="830" MinWidth="940" MinHeight="700" Background="#080B14" WindowStartupLocation="CenterScreen">
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock Text="CYBER TRAP" FontFamily="Bahnschrift" FontSize="42" FontWeight="Bold" Foreground="#F85CA8"/><TextBlock Text="NIGHT CITY  /  STREET CHEM  /  NIVALIS" Foreground="#4EF4DE" FontSize="12"/></StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="#F85CA8" BorderThickness="1" Padding="14,7"><TextBlock Text="SOLO  •  v0.1.0" Foreground="#F85CA8"/></Border>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="SettingsPanel">
        <TextBlock Text="YOUR GAMES" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <TextBlock Text="Cyberpunk 2077" Foreground="#4EF4DE"/><Grid Margin="0,6,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="CyberpunkExe"/><Button Grid.Column="1" Content="Browse" Tag="Cyberpunk" Click="BrowseGame" Margin="8,0,0,0"/></Grid>
        <TextBlock Text="Schedule I" Foreground="#4EF4DE"/><Grid Margin="0,6,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="ScheduleExe"/><Button Grid.Column="1" Content="Browse" Tag="Schedule" Click="BrowseGame" Margin="8,0,0,0"/></Grid>
        <TextBlock Text="Nivalis Nights" Foreground="#4EF4DE"/><Grid Margin="0,6,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="NivalisExe"/><Button Grid.Column="1" Content="Browse" Tag="Nivalis" Click="BrowseGame" Margin="8,0,0,0"/></Grid>
        <Button Content="Detect Steam installations" Click="DetectSteam" HorizontalAlignment="Left" Margin="0,0,0,22"/>
        <TextBlock Text="BACKGROUND SAVES" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock x:Name="NivalisSaveLabel" Text="Select a Nivalis save to create a sandbox copy." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#A9B7CF"/><Button Grid.Column="1" Content="Select save" Click="ChooseNivalis"/></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock x:Name="ScheduleSaveLabel" Text="Schedule I: last played native save" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#A9B7CF"/><Button Grid.Column="1" Content="Select save" Click="ChooseSchedule"/></Grid>
        <CheckBox x:Name="PrepareBusinesses" Content="Prepare all Nivalis businesses on first launch" IsChecked="True" Margin="0,16,0,5"/>
        <CheckBox x:Name="HideGuests" Content="Hide background games and remove their taskbar entries" IsChecked="True"/>
      </StackPanel>
      <Border Grid.Column="2" Background="#111625" BorderBrush="#25304A" BorderThickness="1" Padding="18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="ONE CITY. THREE WORLDS." FontSize="17" FontWeight="Bold" Foreground="#4EF4DE"/>
          <TextBlock Grid.Row="1" Text="Install the crossover and its frameworks, load your background saves, then play in Night City. Load your paired Cyberpunk save normally." TextWrapping="Wrap" Foreground="#A9B7CF" Margin="0,16,0,20"/>
          <TextBox Grid.Row="2" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="#0A0E18" BorderThickness="0"/>
          <StackPanel Grid.Row="3" Margin="0,14,0,0"><ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100" Foreground="#4EF4DE" Background="#20283D" BorderThickness="0"/><TextBlock x:Name="ProgressLabel" Text="Ready" Foreground="#A9B7CF" FontSize="11" Margin="0,5,0,0"/></StackPanel>
          <TextBlock Grid.Row="4" Text="Experimental solo crossover. Own all three games. Your original Nivalis save is kept." TextWrapping="Wrap" Foreground="#7989A4" Margin="0,18,0,0" FontSize="12"/>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button x:Name="ShowButton" Content="Show background games" Click="ShowGuests"/><Button x:Name="RestoreButton" Content="Restore install" Click="RestoreInstall" Margin="8,0,0,0"/></StackPanel>
      <Button Grid.Column="1" x:Name="InstallButton" Content="Install / update mods" Click="Install" Margin="0,0,12,0"/>
      <Button Grid.Column="2" x:Name="LaunchButton" Content="LAUNCH CYBER TRAP" Click="Launch" Background="#4EF4DE" Foreground="#07141A" BorderBrush="#4EF4DE" Padding="24,12"/>
    </Grid>
  </Grid>
</Window>
